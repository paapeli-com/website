{
  "name": "cloud-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cloud Management remote (panel.paapeli.com /CloudManagement) — workspace/account administration, independent of any AIoT product. Mounted into apps/panel/host via Module Federation.",
  "scripts": {
    "dev": "vite build && concurrently -k -n build,preview -c yellow,cyan \"vite build --watch\" \"vite preview --port 8085\"",
    "dev:standalone": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --port 8085"
  },
  "dependencies": {
    "@paapeli/api": "workspace:*",
    "@paapeli/brand": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.3.6",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
