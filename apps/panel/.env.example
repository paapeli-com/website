# Copy to .env (git-ignored) and edit. Only PAAPELI_*- and VITE_*-prefixed vars
# reach client code — see envPrefix in vite.config.ts.
#
# Vite reads these at BUILD time and inlines the values into the bundle, so
# `pnpm dev` must be restarted after a change, and a container image carries
# whatever was set when it was built (ci/docker/panel/Dockerfile takes it as a
# --build-arg, passed by the build-panel job in .gitlab-ci.yml), not what the
# runtime environment holds.

# Absolute origin the API client sends every request to. Calls go straight
# there, in dev too, so the browser's network tab shows the real gateway URL
# rather than localhost — there is no dev proxy.
#
# Must be an absolute origin. Unset or blank falls back to the shared gateway
# below, which is also what an unpassed Docker build arg looks like; blank is
# never read as same-origin, because that would point the panel at its own
# domain and every API response would come back as the HTML shell.
PAAPELI_API_BASE_URL=https://gateway-mini.paapeli.me

# Map.ir API key for the GPS tracking maps (get one at https://corp.map.ir).
# Build-time like the above, and public: it is sent in every tile URL, so lock
# it to the panel's domains in the Map.ir panel. Unset falls back to
# OpenStreetMap tiles.
PAAPELI_MAPIR_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImp0aSI6Ijg1NDc4MTYzZTc1NDI4NWJlZDQxMzhmZmNhNmUxNTY1NTNjOTc4NTc3MWQxZDJkZmY5YzcwNGY4NzAwNDhlMTA2ZmJjODZhZjkxMDAyNGNlIn0.eyJhdWQiOiI0NDE5MiIsImp0aSI6Ijg1NDc4MTYzZTc1NDI4NWJlZDQxMzhmZmNhNmUxNTY1NTNjOTc4NTc3MWQxZDJkZmY5YzcwNGY4NzAwNDhlMTA2ZmJjODZhZjkxMDAyNGNlIiwiaWF0IjoxNzkwMTU0NjgzLCJuYmYiOjE3OTAxNTQ2ODMsImV4cCI6MTc5MjY2MDI4Mywic3ViIjoiIiwic2NvcGVzIjpbImJhc2ljIl19.Wy_EheNPiDmFTQIdo37Gjs_mZ_R2RyDHbPHu53om0i305sNR4ullxX6eMXhq_EfCcdTPzg7tmVzEnC-ydVvVFJ6YjSHuYryxxUHFmrcv6r8ld_WC_XJBGpqPG10nGeRB2Ew4i7hpNgs2nWiqejaLP27_-mF6ETF_Dw4P5cFVdZKt_nZefwJKylumDgr0N2iawzgChF9hnoDocFhsqlTM7NZuaHMEIFaOjfQpaf8qLegMk0DeFTnNMF7C44yOQHUUuVw28-6k3psZNacZYBXZCB5I-4CPmibxnHAkNflPHu0HxU030qPqCb8klwm9VRiicaNRlj60X8duNe1kKo39LQ
