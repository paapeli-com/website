# Copy to .env (git-ignored) and edit. Only PAAPELI_*- and VITE_*-prefixed vars
# reach client code — see envPrefix in vite.config.ts.
#
# Vite reads these at BUILD time and inlines the values into the bundle, so
# `pnpm dev` must be restarted after a change, and a container image carries
# whatever was set when it was built (ci/docker/panel/Dockerfile takes it as a
# --build-arg), not what the runtime environment holds.

# Origin the API client sends every request to. Unset, it defaults to the shared
# gateway below, so `pnpm dev` works with no .env at all.
#
# Set it to an empty value to go same-origin instead, routing calls through the
# Vite dev proxy. That is slower to read in the network tab (every request shows
# as localhost) but it is the only way the gateway's 401s are visible to JS, so
# an expired session actually signs itself out. See src/shared/config.ts.
PAAPELI_API_BASE_URL=https://gateway-mini.paapeli.me
