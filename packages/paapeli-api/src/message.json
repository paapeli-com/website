                }
              }
            }
          }
        }
      }
    },
    "/api/v1/aiot/rpc": {
      "post": {
        "tags": [
          "Device RPC"
        ],
        "summary": "Send RPC command",
        "description": "Send a Remote Procedure Call (RPC) to a device.\n- action: Name of the function/method the device should execute\n- params: Parameters for that function (can be null)\n",
        "operationId": "sendRPC",
        "requestBody": {
          "description": "RPC command",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaapeliDeviceRPC"
              },
              "examples": {
                "Set Temperature Example": {
                  "description": "Set Temperature Example",
                  "value": {
                    "action": "setTemperature",
                    "deviceId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "deviceName": "living-room-sensor",
                    "params": {
                      "temperature": 23.5,
                      "unit": "C"
                    },
                    "isOneWay": false,
                    "queue": false
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "RPC sent successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliMessage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliMessage"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/aiot/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login user",
        "description": "Authenticate with username and password.\nThe returned token must be used in subsequent requests as:\nAuthorization: Bearer \u003Ctoken\u003E\n",
        "operationId": "login",
        "requestBody": {
          "description": "Login credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaapeliAuthRequest"
              },
              "examples": {
                "Login Example": {
                  "description": "Login Example",
                  "value": {
                    "username": "admin@paapeli.me",
                    "password": "your-secure-password"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliAuthResponse"
                },
                "examples": {
                  "Successful Login": {
                    "description": "Successful Login",
                    "value": {
                      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliAuthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/aiot/assets": {
      "post": {
        "tags": [
          "Assets"
        ],
        "summary": "Create an asset",
        "description": "Create root assets by setting parentId to null, or child assets by specifying a parentId.",
        "operationId": "createAsset",
        "requestBody": {
          "description": "Asset creation payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaapeliAsset"
              },
              "examples": {
                "Root Asset": {
                  "summary": "Create a top-level (root) asset",
                  "description": "Root Asset",
                  "value": {
                    "name": "Main Factory",
                    "type": "default",
                    "label": "Factory HQ",
                    "description": "Main production facility",
                    "parentId": null
                  }
                },
                "Child Asset": {
                  "summary": "Create asset under a parent",
                  "description": "Child Asset",
                  "value": {
                    "name": "Production Line 1",
                    "type": "production",
                    "label": "Line A",
                    "description": "Primary assembly line",
                    "parentId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Asset created successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliAsset"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliAsset"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliAsset"
                }
              }
            }
          }
        }
      }
    },
