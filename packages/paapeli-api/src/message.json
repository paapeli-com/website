    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Time series",
      "description": "Time series endpoints"
    },
    {
      "name": "Device RPC",
      "description": "Device RPC endpoints"
    },
    {
      "name": "Devices",
      "description": "Device management endpoints"
