  "paths": {
    "/api/v1/aiot/devices": {
      "put": {
        "tags": [
          "Devices"
        ],
        "summary": "Update device",
        "description": "Edit device name,label and description",
        "operationId": "editDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaapeliEditDeviceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliEditDeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliEditDeviceResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Create a device",
        "description": "Create a new device under an asset. Note: 'credentialValue' is **not required** when credentialType = ACCESS_TOKEN (Backend will auto-generate the token).",
        "operationId": "createDevice",
        "requestBody": {
          "description": "Device creation payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaapeliCreateDeviceRequest"
              },
              "examples": {
                "ACCESS_TOKEN (Recommended)": {
                  "summary": "Simple access token credential (most common)",
                  "description": "ThingsBoard will generate the access token automatically.",
                  "value": {
                    "label": "Living Room Sensor",
                    "type": "default",
                    "name": "temp-sensor-living",
                    "description": "Monitors room temperature",
                    "isGateway": false,
                    "credentialType": "ACCESS_TOKEN",
                    "assetId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                  }
                },
                "X509_CERTIFICATE": {
                  "summary": "X.509 Certificate credential",
                  "description": "Requires credentialValue containing the certificate data.",
                  "value": {
                    "label": "Secure Gateway",
                    "type": "gateway",
                    "name": "secure-gw-01",
                    "description": "X509 secured gateway",
                    "isGateway": true,
                    "credentialType": "X509_CERTIFICATE",
                    "credentialValue": "-----BEGIN CERTIFICATE-----\nMIIC...\n-----END CERTIFICATE-----",
                    "assetId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                  }
                },
                "MQTT_BASIC": {
                  "summary": "MQTT Basic credentials",
                  "description": "Requires escaped json style credential.",
                  "value": {
                    "label": "MQTT Device",
                    "type": "sensor",
                    "name": "mqtt-sensor-01",
                    "credentialType": "MQTT_BASIC",
                    "credentialValue": "{\"clientId\":\"5euh5nzm34bjjh1efmlt\",\"userName\":\"onasd1lgwasmjl7v2v7h\",\"password\":\"b9xtm4ny8kt9zewaga5o\"}",
                    "assetId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Device created successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliCreateDeviceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliCreateDeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaapeliCreateDeviceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/tb/events": {
      "post": {
        "tags": [
          "internal-controller"
        ],
        "operationId": "handleEvent",
        "parameters": [
          {
            "name": "X-Paapeli-Ingestion-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
