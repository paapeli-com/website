            "example": "setTemperature"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "Target device ID",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "deviceName": {
            "type": "string",
            "description": "Device name",
            "example": "living-room-sensor"
          },
          "params": {
            "type": "object",
            "additionalProperties": {

            },
            "description": "Parameters for the action (can be null or empty)",
            "example": {
              "temperature": 23.5,
              "unit": "C"
            }
          },
          "isOneWay": {
            "type": "boolean",
            "default": false,
            "description": "One-way RPC (fire and forget). Default: false",
            "example": false
          },
          "queue": {
            "type": "boolean",
            "default": false,
            "description": "Queue the RPC if device is offline. Default: false",
            "example": false
          }
        },
        "required": [
          "action",
          "deviceId",
          "deviceName"
        ]
